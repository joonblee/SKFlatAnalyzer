 ////////////////////////
 void SKFlatMaker::fillGENInfo(const edm::Event &iEvent)
 {
+  if (storeFiducialGenJets && !iEvent.isRealData()) {
+    edm::Handle<reco::JetFlavourInfoMatchingCollection> flavours;
+    iEvent.getByToken(fiducialGenJetFlavourToken, flavours);
+    if (!m_genJets.isValid() || !flavours.isValid()) {
+      throw cms::Exception("ProductNotFound")
+          << "Run 2 fiducial cutflow requires AK4 slimmedGenJets and slimmedGenJetsFlavourInfos";
+    }
+
+    for (const auto &jet : *m_genJets) {
+      int hadronFlavour = 0;
+      // Same first association within DeltaR < 0.1 as the AK4 NanoAOD table.
+      for (const auto &match : *flavours) {
+        if (deltaR(jet.p4(), match.first->p4()) < 0.1) {
+          hadronFlavour = match.second.getHadronFlavour();
+          break;
+        }
+      }
+      genjet_pt.push_back(jet.pt());
+      genjet_eta.push_back(jet.eta());
+      genjet_phi.push_back(jet.phi());
+      genjet_mass.push_back(jet.mass());
+      genjet_hadronFlavour.push_back(hadronFlavour);
+    }
+  }
   //cout << "fill pdf info" << endl;
   
   edm::Handle<reco::GenParticleCollection> genParticles;
